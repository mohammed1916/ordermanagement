rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Products collection - public read, admin write
    match /products/{productId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Product categories - public read, admin write
    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Product variants - public read, admin write
    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.isAdmin == true);
      
      // Allow updates for:
      // 1. Admins (full access)
      // 2. Order owners for cancellation only (with strict conditions)
      allow update: if request.auth != null && (
        // Admin has full update access
        request.auth.token.isAdmin == true ||
        
        // Order owner can only cancel their own orders with specific conditions
        (resource.data.userId == request.auth.uid && 
         isValidOrderCancellation(resource.data, request.resource.data))
      );
      
      allow delete: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // Helper function to validate order cancellation
    function isValidOrderCancellation(existingOrder, updatedOrder) {
      return 
        // Order must be in a cancellable status
        existingOrder.status in ['pending', 'paid', 'processing'] &&
        
        // Status must be changed to cancelled
        updatedOrder.status == 'cancelled' &&
        
        // Critical fields cannot be modified by customer
        existingOrder.userId == updatedOrder.userId &&
        existingOrder.pricing == updatedOrder.pricing &&
        existingOrder.items == updatedOrder.items &&
        existingOrder.shippingAddress == updatedOrder.shippingAddress &&
        existingOrder.orderNumber == updatedOrder.orderNumber &&
        existingOrder.createdAt == updatedOrder.createdAt &&
        
        // Timeline must be extended (not replaced)
        updatedOrder.timeline.size() >= existingOrder.timeline.size() &&
        
        // New timeline entry must be a cancellation
        updatedOrder.timeline[updatedOrder.timeline.size() - 1].status == 'cancelled';
    }
    
    // Carts collection
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Coupons collection
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Coupon usage tracking
    match /couponUsage/{usageId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.isAdmin == true);
    }
    
    // Product reviews
    match /productReviews/{reviewId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if resource.data.isApproved == true;
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Wishlists
    match /wishlists/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Analytics collections (admin only)
    match /productViews/{viewId} {
      allow create: if true; // Allow anonymous tracking
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    match /searchQueries/{queryId} {
      allow create: if true; // Allow anonymous search tracking
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Inventory transactions (admin only)
    match /inventoryTransactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.token.isAdmin == true;
    }
    
    // Legacy collections for backward compatibility
    match /deliveries/{deliveryId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && 
        (resource.data.userId == request.auth.uid || request.auth.token.isAdmin == true);
      allow update, delete: if request.auth != null && request.auth.token.isAdmin == true;
    }
  }
} 